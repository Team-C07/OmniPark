@startuml sd_sosta_2
actor "Automobilista" as Auto
boundary ":MappaStalli" as UI
control ":ControlloProlungamento" as Ctrl
entity ":Sosta" as Sosta
entity ":Tariffa" as Tariffa
entity ":Wallet virtuale" as Wallet

loop [finché la durata complessiva supera la durata massima (2.a2)]
  Auto -> UI : 1: prolunga(sosta, tempoAggiuntivo)
  UI -> Ctrl : 1.1: prolunga(sosta, tempoAggiuntivo)
  Ctrl -> Sosta : 2.1: statoEOrari()
  Ctrl -> Tariffa : 2.2: durataMassima()

  opt [2.a2 Durata complessiva oltre la durata massima]
    Ctrl -> UI : 2.a2.1: segnalaDurataEccessiva(tempoDisponibile)
  end
end

break [2.a1 La sosta è già Scaduta]
  Ctrl -> UI : 2.a1.1: segnalaSostaScaduta()
end

Ctrl -> Tariffa : 3.1: costoOrarioEOrariDiVigenza()
Ctrl -> Ctrl : 3.2: calcolaImporto(tempoAggiuntivo, tipoDiStallo)
Ctrl -> UI : 3.3: mostraImporto(importo, nuovaScadenza)

break [4.a1 L'Automobilista annulla]
  Auto -> UI : 4.a1: annulla()
end

loop [finché il credito non basta e l'Automobilista ricarica (5.a1)]
  Auto -> UI : 4: conferma()
  UI -> Ctrl : 4.1: conferma()
  Ctrl -> Wallet : 5.1: saldo()

  opt [5.a1 Credito insufficiente]
    Ctrl -> UI : 5.a1.1: proponiRicarica(importo)
    ref over Auto, UI, Ctrl, Wallet : SD_WALLET_1 — punto di estensione «Credito insufficiente».\nSe l'Automobilista rinuncia, la scadenza non cambia
  end
end

create entity ":Movimento del wallet" as Mov
Ctrl --> Mov : 5.2: <<create>>(addebito, importo)
Ctrl -> Wallet : 5.3: registra(movimento)
Ctrl -> Mov : 5.4: addebitatoPer(sosta)
Ctrl -> Sosta : 6.1: aggiornaScadenza(nuovaScadenza)
Ctrl -> UI : 6.2: confermaScadenza(nuovaScadenza)
@enduml