# Stringa di connessione pooled (host con -pooler) del database di sviluppo condiviso:
# database omnipark del branch Neon dev-teamc07, con sslmode=verify-full.
# Il valore reale lo distribuiscono i PM: non va mai versionato né condiviso.
DATABASE_URL="postgresql://UTENTE:PASSWORD@ep-ESEMPIO-pooler.REGIONE.aws.neon.tech/NOME_DATABASE?sslmode=verify-full"

# Solo "sviluppo" o "test" abilitano npm run db:reset, che cancella i dati di tutto il team.
# Lascia il valore segnaposto: il reset lo eseguono solo i PM, dopo aver avvisato il team.
OMNIPARK_AMBIENTE=indica_sviluppo_o_test
